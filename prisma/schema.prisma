generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth / User

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  username      String   @unique
  bio           String?
  avatar        String?
  coverPhoto    String?
  gearList      String?
  playStyle     String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posts           Post[]
  comments        Comment[]
  votes           Vote[]
  listings        MarketplaceListing[]
  rsvps           RSVP[]
  memberships     GroupMembership[]
  eventsCreated   GameEvent[]    @relation("organizer")
  reviewsGiven    SellerReview[] @relation("ReviewerRelation")
  reviewsReceived SellerReview[] @relation("SellerRelation")
  notifications   Notification[]
  postsRemoved     Post[]          @relation("PostsRemovedBy")
  commentsRemoved  Comment[]       @relation("CommentsRemovedBy")
  reportsSubmitted Report[]        @relation("ReportsSubmitted")
  reportsResolved  Report[]        @relation("ReportsResolved")
  auditLogActions  AuditLogEntry[] @relation("AuditLogActions")
  bans             Ban[]           @relation("UserBans")
  bansIssued       Ban[]           @relation("BansIssued")
  bansLifted       Ban[]           @relation("BansLifted")
  modNotesAbout    ModNote[]       @relation("NotesAbout")
  modNotesAuthored ModNote[]       @relation("NotesAuthored")

  // Better Auth
  sessions Session[]
  accounts Account[]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

// Better Auth tables

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// Forum

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  tags      String[]
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  poll      Poll?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft-delete fields — set by mod actions, never actually removed from DB.
  // deletedByAuthor=true means the author removed their own post.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("PostsRemovedBy", fields: [deletedById], references: [id])
  deletionReason String?
  deletedByAuthor Boolean  @default(false)

  comments Comment[]
  votes    Vote[]
}

model Comment {
  id              String    @id @default(cuid())
  content         String
  postId          String
  authorId        String
  parentCommentId String?
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  createdAt       DateTime  @default(now())

  // Soft-delete fields
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?     @relation("CommentsRemovedBy", fields: [deletedById], references: [id])
  deletionReason  String?
  deletedByAuthor Boolean   @default(false)
}

model Vote {
  userId String
  postId String
  value  Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Poll {
  id          String       @id @default(cuid())
  postId      String       @unique
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  question    String
  multiSelect Boolean      @default(false)
  expiresAt   DateTime?
  status      PollStatus   @default(OPEN)
  options     PollOption[]
  createdAt   DateTime     @default(now())
}

model PollOption {
  id     String      @id @default(cuid())
  pollId String
  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]
}

model PollVote {
  userId   String
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, optionId])
}

enum PollStatus {
  OPEN
  CLOSED
}

// Marketplace

model MarketplaceListing {
  id          String        @id @default(cuid())
  sellerId    String
  title       String
  description String
  price       Decimal
  condition   ItemCondition
  category    String
  images      String[]
  status      ListingStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews     SellerReview[]
}

enum ItemCondition {
  NEW
  LIKE_NEW
  USED
  FOR_PARTS
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model SellerReview {
  id         String              @id @default(cuid())
  sellerId   String
  reviewerId String
  listingId  String?
  rating     Int
  comment    String?
  createdAt  DateTime            @default(now())
  seller     User                @relation("SellerRelation", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer   User                @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  listing    MarketplaceListing? @relation(fields: [listingId], references: [id])
}

// Events

model GameEvent {
  id           String      @id @default(cuid())
  organizerId  String
  groupId      String?
  title        String
  description  String?
  gameSite     String
  gameType     String
  date         DateTime
  time         String?
  entranceFee  Decimal?
  lat          Float
  lng          Float
  locationName String
  playerCap    Int?
  rules        String?
  status       EventStatus @default(UPCOMING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  group     Group?     @relation("group", fields: [groupId], references: [id])
  organizer User       @relation("organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps     RSVP[]
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model RSVP {
  userId    String
  eventId   String
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     GameEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

enum RSVPStatus {
  GOING
  MAYBE
  CANCELLED
}

// Groups

model Group {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  banner      String?
  createdAt   DateTime @default(now())

  members GroupMembership[]
  events  GameEvent[]        @relation("group")
}

model GroupMembership {
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

enum GroupRole {
  MEMBER
  ADMIN
  OWNER
}

// Bans & mod notes

model Ban {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserBans", fields: [userId], references: [id], onDelete: Cascade)
  bannedById String
  bannedBy   User      @relation("BansIssued", fields: [bannedById], references: [id])
  reason     String
  expiresAt  DateTime?
  liftedAt   DateTime?
  liftedById String?
  liftedBy   User?     @relation("BansLifted", fields: [liftedById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model ModNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotesAbout", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NotesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Moderation

enum ModerationTarget {
  POST
  COMMENT
  LISTING
  USER
  EVENT
  GROUP
}

enum ReportCategory {
  SPAM
  HARASSMENT
  HATE_SPEECH
  NSFW
  MISINFORMATION
  OFF_TOPIC
  CHEATING_ACCUSATION_WITHOUT_PROOF
  DOXXING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
}

enum AuditAction {
  POST_REMOVED
  POST_RESTORED
  POST_PINNED
  POST_UNPINNED
  POST_LOCKED
  POST_UNLOCKED
  COMMENT_REMOVED
  COMMENT_RESTORED
  LISTING_REMOVED
  LISTING_RESTORED
  EVENT_CANCELLED
  GROUP_REMOVED
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED
  REPORT_DISMISSED
  REPORT_RESOLVED
}

// Polymorphic report — one model covers all reportable target types
model Report {
  id             String         @id @default(cuid())
  reporterId     String
  reporter       User           @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ModerationTarget
  targetId       String
  category       ReportCategory
  reason         String?
  status         ReportStatus   @default(OPEN)
  resolvedById   String?
  resolvedBy     User?          @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Append-only audit trail for all mod actions
model AuditLogEntry {
  id         String           @id @default(cuid())
  actorId    String
  actor      User             @relation("AuditLogActions", fields: [actorId], references: [id], onDelete: Cascade)
  action     AuditAction
  targetType ModerationTarget
  targetId   String
  reason     String?
  metadata   Json?
  public     Boolean          @default(true)
  createdAt  DateTime         @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// Notifications

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
